# Variáveis de ambiente do Destravaí — EXEMPLO (sem valores reais).
# Copie para .env.local (NUNCA commitar .env.local) e preencha. Em produção,
# defina no painel do Netlify (e os secrets de IA também na Edge Function do Supabase).

# ── Frontend (Vite) — expostas no browser, use apenas chaves públicas ──────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Liga o paywall (exige assinatura ativa). "true" em produção.
VITE_PAYWALL_ENABLED=
# E-mail do admin (dono) — nunca é bloqueado pelo paywall. Default no código:
# assessoriadbe@gmail.com. Defina aqui só se quiser sobrescrever.
VITE_ADMIN_EMAIL=

# ── Backend (Netlify Functions) — NUNCA expor no frontend ──────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL base do app (redirects e link de e-mail de acesso). Ex.: https://destravai.dbe.digital
APP_URL=
ADMIN_EMAIL=

# ── Asaas (pagamentos) ─────────────────────────────────────────────────────────
# Produção: https://api.asaas.com/v3 | Sandbox: https://sandbox.asaas.com/api/v3
ASAAS_BASE_URL=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ── IA (OpenRouter primário + Gemini fallback) ────────────────────────────────
# Definir TAMBÉM como secrets da Edge Function do Supabase (caminho principal da IA).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_PRIMARY=openrouter
AI_MODEL_PRIMARY=deepseek/deepseek-v4-flash
AI_PROVIDER_FALLBACK=gemini
AI_MODEL_FALLBACK=gemini-2.5-flash-lite
# Chave do Gemini (usada no fallback). No backend, nunca no frontend.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Resend (e-mails transacionais) ─────────────────────────────────────────────
# NÃO há variável no app. As credenciais SMTP do Resend ficam SOMENTE no painel
# do Supabase (Authentication → SMTP Settings). Veja docs/email-auth-resend-supabase.md
